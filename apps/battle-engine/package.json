{
  "name": "@pokebattle/battle-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import": "tsx src/import/cli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@pokebattle/shared": "workspace:*",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@pokebattle/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
