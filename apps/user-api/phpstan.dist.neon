parameters:
    level: max
    paths:
        - src/
        - tests/
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
        # Entities stay incomplete until API Platform validates them; the NOT NULL
        # columns remain the guard against persisting one that is.
        allowNullablePropertyForRequiredField: true
