{
  "name": "pokebattle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "pnpm --filter @pokebattle/battle-engine db:up",
    "db:down": "pnpm --filter @pokebattle/battle-engine db:down",
    "api:up": "cd apps/user-api && docker compose up --wait",
    "api:down": "cd apps/user-api && docker compose down --remove-orphans"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
